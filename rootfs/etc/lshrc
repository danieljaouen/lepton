# /etc/lshrc - system-wide lsh startup file.
# Loaded before ~/.zshrc (imported) and ~/.lshrc.

export PAGER=less
export LESS=-R
export LSCOLORS=exfxcxdxbxegedabagacad

alias ll='ls -l'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias md='mkdir -p'
alias rd=rmdir
alias history-stat='history | awk "{print \$2}" | sort | uniq -c | sort -rn | head'

# oh-my-zsh "git" plugin (enabled in the user's zshrc); their own aliases
# in ~/.zshrc are applied afterwards and take precedence.
alias g=git
alias ga='git add'
alias gaa='git add --all'
alias gb='git branch'
alias gba='git branch -a'
alias gbd='git branch -d'
alias gcb='git checkout -b'
alias gcm='git checkout main'
alias gco='git checkout'
alias gcmsg='git commit -m'
alias gd='git diff'
alias gdca='git diff --cached'
alias gf='git fetch'
alias gl='git pull'
alias glo='git log --oneline'
alias glog='git log --oneline --graph'
alias gm='git merge'
alias gp='git push'
alias grs='git restore'
alias gst='git status'
alias gsta='git stash'
alias gstp='git stash pop'
alias gsw='git switch'

# oh-my-zsh "mix" plugin
alias mt='mix test'

# PostgreSQL's tools (createdb, pg_dump, ...) connect as its superuser
# role, postgres: the native programs Lepton runs are root's, and
# PostgreSQL has no root role (see: postgresql).
export PGUSER=postgres
